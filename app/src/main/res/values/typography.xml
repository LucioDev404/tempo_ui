<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="InterFontFamily">
        <item name="android:fontFamily">@font/inter</item>
    </style>

    <style name="BaseTextAppearance" parent="InterFontFamily">
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <!-- Headlines (screen titles) -->
    <style name="HeadlineLarge" parent="BaseTextAppearance">
        <item name="android:textSize">28sp</item>
        <item name="android:textFontWeight">700</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="HeadlineMedium" parent="BaseTextAppearance">
        <item name="android:textSize">24sp</item>
        <item name="android:textFontWeight">700</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="HeadlineSmall" parent="BaseTextAppearance">
        <item name="android:textSize">22sp</item>
        <item name="android:textFontWeight">700</item>
    </style>

    <!-- Titles -->
    <style name="TitleLarge" parent="BaseTextAppearance">
        <item name="android:textSize">22sp</item>
        <item name="android:textFontWeight">700</item>
    </style>

    <style name="TitleMedium" parent="BaseTextAppearance">
        <item name="android:textSize">15sp</item>
        <item name="android:textFontWeight">500</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="TitleSmall" parent="BaseTextAppearance">
        <item name="android:textSize">13sp</item>
        <item name="android:textFontWeight">500</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <!-- Labels -->
    <style name="LabelExtraLarge" parent="BaseTextAppearance">
        <item name="android:textSize">20sp</item>
        <item name="android:textFontWeight">700</item>
    </style>

    <style name="LabelLarge" parent="BaseTextAppearance">
        <item name="android:textSize">16sp</item>
        <item name="android:textFontWeight">700</item>
    </style>

    <style name="LabelMedium" parent="BaseTextAppearance">
        <item name="android:textSize">14sp</item>
        <item name="android:textFontWeight">500</item>
    </style>

    <style name="LabelSmall" parent="BaseTextAppearance">
        <item name="android:textSize">12sp</item>
        <item name="android:textFontWeight">400</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="LabelExtraSmall" parent="BaseTextAppearance">
        <item name="android:textSize">10sp</item>
        <item name="android:textFontWeight">400</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <!-- Body -->
    <style name="BodyLarge" parent="BaseTextAppearance">
        <item name="android:textSize">16sp</item>
        <item name="android:textFontWeight">400</item>
    </style>

    <style name="BodyMedium" parent="BaseTextAppearance">
        <item name="android:textSize">14sp</item>
        <item name="android:textFontWeight">500</item>
    </style>

    <style name="BodySmall" parent="BaseTextAppearance">
        <item name="android:textSize">12sp</item>
        <item name="android:textFontWeight">400</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>
</resources>
